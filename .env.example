# Copy this file to .env and fill in real values. .env is git-ignored.
# Used by compose.yaml (local run) and, after `set -a; . ./.env; set +a`, by stack.yml (Swarm).

# Container registry namespace, e.g. jsmith for docker.io/jsmith
REGISTRY_USER=your-registry-namespace

# MySQL passwords
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# Shown on the page (Task requirement)
STUDENT=Your Full Name
COLLEGE=Your College

# Swarm only: hostname of the node that holds the DB volume (e.g. node1)
SWARM_DB_NODE=node1
